# setup.cmd (Windows) or ./setup.sh (macOS) creates .env automatically.
# Set this only when running Docker Compose without the setup script.
# Windows example:
# GPT_CODEX_ROUTER_STATE_ROOT=C:/Users/you/AppData/Roaming/GPTCodexRouter
# macOS example:
# GPT_CODEX_ROUTER_STATE_ROOT=/Users/you/Library/Application Support/GPTCodexRouter
